# Project Athena -- environment variables. Copy this file to `.env`
# (git-ignored, never commit real values) and fill in whichever of these
# your work actually needs; every one below is genuinely optional -- the
# project runs, and its full test suite passes, with none of them set.
#
# This list was generated by grepping production/src/ for every real
# os.environ.get(...)/os.getenv(...) call, not written from memory or from
# docstrings alone -- these three are the complete set as of this writing.

# Roboflow API key -- required only for the local, non-served pitch-keypoint
# anchor-recalibration prototype (production/src/cv/pitch_keypoint_detector.py's
# _get_model(), a deliberately lazy, function-local import). See ADR-014 for
# why this is scoped to strictly local/non-served use (AGPL-derived model
# weights, unverified training-data provenance). Get a key at
# https://roboflow.com -- without it, any code path that calls
# pitch_keypoint_detector.py's _get_model() raises a clear RuntimeError
# rather than proceeding silently.
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# SoccerNet tracking-dataset download password -- required only to exercise
# the SoccerNet-gated tests/validation (production/src/cv/acquisition.py) and
# close the CV track's real-data ground-truth gap (see CV_PIPELINE_FINDINGS.md
# Section 3). This is a real, individually-issued NDA/research-use credential,
# not something obtainable automatically -- register at
# https://www.soccer-net.org and request tracking-task access. Without it,
# the SoccerNet-gated test skips cleanly (never fails or hangs).
SOCCERNET_PASSWORD=your_soccernet_password_here

# Gemini API key -- required only for the real Gemini Flash-Lite explanation
# executor (production/src/models/explainer.py's generate_explanation_real(),
# see ADR-006's Update section). Get a key at https://aistudio.google.com/apikey.
# Without it, generate_tactical_explanation() automatically and silently falls
# back to the deterministic mock executor -- no crash, no missing feature,
# just template-style explanation text instead of real LLM prose.
GEMINI_API_KEY=your_gemini_api_key_here

# Public-deployment mode switch (ADR-021's compliance fix) -- set to "true"
# on BOTH the api.py process AND the dashboard.py process when deploying
# this app somewhere the general public can reach it. Unset/"false" (the
# default): identical behavior to before this flag existed -- local/private
# research use, the shot map shows real per-shot data. Set to "true": the
# shot map serves/renders only an aggregated density/xG grid (no individual
# shot location is ever exposed, per ADR-021 condition 2), and the Team
# Trends tab is disabled entirely (its football-data.co.uk data source has
# its own separate "never served/distributed" restriction -- see
# team_trend_data.py and ADR-018's Update section). See README.md's
# "Public deployment mode" section for the full explanation.
PUBLIC_DEPLOYMENT=false
